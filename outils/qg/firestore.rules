rules_version = '2';
// QG du Comptoir : règles de la base Firestore.
// À coller dans la console Firebase : Firestore Database > Règles > Publier.
// Deux niveaux d'accès, enregistrés dans la collection « acces » (une fiche par adresse e-mail vérifiée) :
//  - bureau : tout le QG (agenda, tâches, coordination, annonces, liste des accès) ;
//  - membre du club : agenda, annonces et fiches du bureau en lecture, « Je viens » pour soi, révisions, boîte à idées.
service cloud.firestore {
  match /databases/{database}/documents {

    function connecte() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function adresse() {
      return request.auth.token.email.lower();
    }
    function fiche() {
      return get(/databases/$(database)/documents/acces/$(adresse())).data;
    }
    // Le président : toujours du bureau et administrateur (même adresse que « proprietaire » dans assets/qg/config.js)
    function president() {
      return connecte() && adresse() == 'jblucas.denis@audencia.com';
    }
    function inscrit() {
      return president() || (connecte() && exists(/databases/$(database)/documents/acces/$(adresse())));
    }
    function bureau() {
      return president() || (inscrit() && fiche().get('role', 'bureau') == 'bureau');
    }
    function admin() {
      return president() || (bureau() && fiche().get('admin', false) == true);
    }

    // Liste des accès : le bureau la lit, chacun lit sa propre fiche, les administrateurs la modifient
    match /acces/{mail} {
      allow read: if bureau() || (inscrit() && mail == adresse());
      allow create, update: if admin() && request.resource.data.get('role', 'bureau') in ['bureau', 'membre'];
      allow delete: if admin() && mail != 'jblucas.denis@audencia.com';
    }

    // Agenda, annonces, fiches du bureau : lus par tous les inscrits, modifiés par le bureau
    match /evenements/{id} {
      allow read: if inscrit();
      allow write: if bureau();
    }
    match /annonces/{id} {
      allow read: if inscrit();
      allow write: if bureau();
    }
    match /membres/{id} {
      allow read: if inscrit();
      allow write: if bureau();
    }

    // « Je viens » : chacun ajoute ou retire sa propre présence ; le bureau peut tout corriger
    match /presences/{id} {
      allow read: if inscrit();
      allow create, update: if bureau() || (inscrit() && request.resource.data.mail == adresse());
      allow delete: if bureau() || (inscrit() && resource.data.mail == adresse());
    }

    // Révisions (fiches et quiz) : lues par tous les inscrits, publiées par le bureau
    match /revisions/{id} {
      allow read: if inscrit();
      allow write: if bureau();
    }

    // Boîte à idées : chaque inscrit colle ses idées (post-its), les modifie ou les retire, et soutient celles des autres (+1) ;
    // le bureau les traite (étape, réponse) et peut tout corriger. L'auteur est repéré par son identifiant de connexion, pas par son adresse.
    function ideeValide(d) {
      return d.keys().hasOnly(['titre', 'detail', 'categorie', 'statut', 'auteurUid', 'nom', 'soutiens', 'noteBureau', 'creeLe', 'majLe'])
        && d.titre is string && d.titre.size() > 0 && d.titre.size() <= 120
        && d.get('detail', '') is string && d.get('detail', '').size() <= 800
        && d.get('nom', '') is string && d.get('nom', '').size() <= 80
        && d.get('noteBureau', '') is string && d.get('noteBureau', '').size() <= 600
        && d.categorie in ['evenement', 'meet', 'sortie', 'revision', 'club', 'autre']
        && d.statut in ['nouvelle', 'etude', 'retenue', 'programmee', 'ecartee']
        && d.soutiens is list && d.soutiens.size() <= 500
        && d.auteurUid is string;
    }
    function seulement(champs) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(champs);
    }
    // Un « +1 » : la personne ajoute ou retire uniquement son propre identifiant
    function unSoutien() {
      let avant = resource.data.get('soutiens', []).toSet();
      let apres = request.resource.data.soutiens.toSet();
      let moi = [request.auth.uid].toSet();
      return (apres.difference(avant) == moi && avant.difference(apres).size() == 0)
        || (avant.difference(apres) == moi && apres.difference(avant).size() == 0);
    }
    match /idees/{id} {
      allow read: if inscrit();
      allow create: if (admin() && ideeValide(request.resource.data))
        || (inscrit() && ideeValide(request.resource.data)
          && request.resource.data.auteurUid == request.auth.uid
          && request.resource.data.statut == 'nouvelle'
          && request.resource.data.soutiens.size() == 0
          && !('noteBureau' in request.resource.data));
      allow update: if inscrit() && ideeValide(request.resource.data)
        && request.resource.data.auteurUid == resource.data.auteurUid
        && (bureau()
          || (resource.data.auteurUid == request.auth.uid && seulement(['titre', 'detail', 'categorie', 'majLe']))
          || (seulement(['soutiens']) && unSoutien()));
      allow delete: if bureau() || (inscrit() && resource.data.auteurUid == request.auth.uid);
    }

    // Tâches et coordination : réservées au bureau
    match /taches/{id} {
      allow read, write: if bureau();
    }
    match /preparations/{id} {
      allow read, write: if bureau();
    }

    // Appareils inscrits aux notifications : chacun enregistre les siens, personne ne les lit
    // (seul l'envoyeur automatique, outils/qg/notifier.py, y accède, sans clé, via la fédération d'identité GitHub)
    match /jetons/{jeton} {
      allow create, update: if inscrit() && request.resource.data.mail == adresse();
      allow delete: if inscrit() && resource.data.mail == adresse();
    }
  }
}
